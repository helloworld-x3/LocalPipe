# LLM API Key（任何 OpenAI 兼容接口均可，DeepSeek / 通义千问 / OpenAI）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://your-provider.com
LLM_MODEL=your-model-name

# 核心候选选择：competitive=三路线竞争（默认）；legacy=单路线紧急回退
LOCALPIPE_SELECTION_MODE=competitive

# 可选：三路线并行执行（默认 0=串行，保证日志与行为顺序确定；置 1 后单任务 LLM 耗时约降为 1/3，
# 全局速率限制仍生效，费用可控。跑行为测试请保持 0）
LOCALPIPE_PARALLEL_ROUTES=0

# 飞书自建应用（需开通多维表格权限）
FEISHU_APP_ID=your-app-id
FEISHU_APP_SECRET=your-app-secret
# 默认 https://open.feishu.cn
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_AUTOMATION_TOKEN=replace-with-a-long-random-token
# 可选：自动化事件台账，默认 .cache/feishu_automation_events.jsonl
# FEISHU_AUTOMATION_LEDGER=.cache/feishu_automation_events.jsonl

# 任务表（已有）
FEISHU_APP_TOKEN=your-bitable-app-token
FEISHU_TASK_TABLE_ID=your-task-table-id
# 结果表（已有，可与其他表不同应用）
FEISHU_OUTPUT_TABLE_ID=your-output-table-id
FEISHU_OUTPUT_APP_TOKEN=your-output-app-token   # 缺省回退 FEISHU_APP_TOKEN

# 人工审核表（闭环新增，需在飞书按 docs/feishu-integration-mvp.md 建表）
FEISHU_REVIEW_TABLE_ID=your-review-table-id
FEISHU_REVISION_TABLE_ID=your-revision-table-id
# 审核表/候选表若在独立应用，用下面两个覆盖；否则缺省回退 FEISHU_OUTPUT_APP_TOKEN
FEISHU_REVIEW_APP_TOKEN=
FEISHU_REVISION_APP_TOKEN=

# 可选：企业字段名与默认不同时覆盖（默认中文列名）
# FEISHU_FIELD_SOURCE=中文原文
# FEISHU_FIELD_MARKET=目标市场
# FEISHU_FIELD_STATUS=状态
# FEISHU_FIELD_TASK_ID=任务ID
